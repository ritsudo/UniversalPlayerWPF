<Window x:Class="UniversalPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Player"
        Height="820" Width="1440" MinHeight="600" MinWidth="980"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="13" FontFamily="Segoe UI"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="&#x266B;" FontSize="22" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Universal Player" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBox MinWidth="140" HorizontalAlignment="Stretch" Padding="8,5,28,5"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource InlineIconButton}" Content="&#x2715;"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}}"
                                Command="{Binding ClearSearchCommand}" ToolTip="Clear search"/>
                    </Grid>
                </Grid>

                <ComboBox Grid.Column="2" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Genres}" SelectedItem="{Binding GenreFilter}"/>

                <Button Grid.Column="3" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                        Content="Rescan" ToolTip="Rescan the music folder and classify new tracks" Command="{Binding RescanCommand}"/>

                <Button Grid.Column="4" Margin="0,0,8,0" Content="Analyze" ToolTip="Classify tracks that have no genre yet"
                        Command="{Binding AnalyzeCommand}"/>

                <Button Grid.Column="5" Content="&#x21BB;" ToolTip="Refresh views" Command="{Binding RefreshCommand}"
                        Width="36" Height="30" Padding="0"/>
            </Grid>
        </Border>

        <!-- ================= main ================= -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- library -->
                <TabItem Header="Library">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="&#x25B6; Play all" Style="{StaticResource AccentButton}" Command="{Binding PlayAllCommand}" Margin="0,0,8,0"/>
                            <Button Content="Add to queue" Command="{Binding AddToQueueCommand}" CommandParameter="{Binding SelectedTrack}" Margin="0,0,8,0"/>
                            <Button Content="Analyse content" Command="{Binding AnalyzeContentCommand}" Margin="0,0,8,0"
                                    ToolTip="Run the local content analysis (instrument / mood tags) on unanalysed tracks"/>
                            <Button Content="Stop" Command="{Binding StopAnalysisCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}"/>
                            <CheckBox Content="only unanalysed" IsChecked="{Binding AnalyseOnlyUnanalysed}" Foreground="{StaticResource Text}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Content="full rescan" IsChecked="{Binding FullRescan}" Foreground="{StaticResource Text}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="Re-check every folder; off = only folders whose contents changed"/>
                            <TextBlock Text="{Binding LibraryCountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <ListView x:Name="LibraryList" Grid.Row="1"
                                  ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedTrack}"
                                  MouseDoubleClick="LibraryList_MouseDoubleClick"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play" Command="{Binding PlayTrackCommand}" CommandParameter="{Binding SelectedTrack}"/>
                                    <MenuItem Header="Add to queue" Command="{Binding AddToQueueCommand}" CommandParameter="{Binding SelectedTrack}"/>
                                    <Separator/>
                                    <MenuItem Header="Add to playlist" ItemsSource="{Binding Playlists}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                <Setter Property="Command" Value="{Binding DataContext.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Title" Width="280" DisplayMemberBinding="{Binding DisplayTitle}"/>
                                    <GridViewColumn Header="Artist" Width="180" DisplayMemberBinding="{Binding DisplayArtist}"/>
                                    <GridViewColumn Header="Album" Width="180" DisplayMemberBinding="{Binding DisplayAlbum}"/>
                                    <GridViewColumn Header="Genre" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayGenre}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Tags" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayTags}" ToolTip="{Binding ContentTags}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Src" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding GenreSource, Converter={StaticResource GenreSource}}" Foreground="{StaticResource Muted}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Time" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DurationMs, Converter={StaticResource MsToTime}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Plays" Width="60" DisplayMemberBinding="{Binding PlayCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Edit selected" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedTrack.DisplayTitle}" Foreground="{StaticResource Muted}" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" VerticalAlignment="Center" ToolTip="Genre (editable if the tag is wrong)"
                                         Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2" Text="Tags" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource Muted}"/>
                                <TextBox Grid.Column="3" VerticalAlignment="Center" ToolTip="Content tags, separated by ';' (editable)"
                                         Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="4" Content="Save" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                        Command="{Binding SaveTrackEditsCommand}"/>
                                <Button Grid.Column="5" Content="Clear tags" Margin="6,0,0,0" Command="{Binding ClearTrackTagsCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- playlists -->
                <TabItem Header="Playlists">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="150" Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Content="Create" Command="{Binding CreatePlaylistCommand}"/>
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Playlist" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Items" Width="60" DisplayMemberBinding="{Binding ItemCount}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="&#x25B6; Play" Style="{StaticResource AccentButton}" Command="{Binding PlayPlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Margin="0,0,8,0"/>
                                <Button Content="Delete playlist" Command="{Binding DeletePlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Margin="0,0,8,0"/>
                                <Button Content="Add selected track" Command="{Binding AddToPlaylistCommand}" CommandParameter="{Binding SelectedPlaylist}" Margin="0,0,8,0"/>
                                <Button Content="Remove" Command="{Binding RemoveFromPlaylistCommand}" CommandParameter="{Binding SelectedQueueTrack}"/>
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{Binding PlaylistTracks}" SelectedItem="{Binding SelectedQueueTrack}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Title" Width="280" DisplayMemberBinding="{Binding DisplayTitle}"/>
                                        <GridViewColumn Header="Artist" Width="180" DisplayMemberBinding="{Binding DisplayArtist}"/>
                                        <GridViewColumn Header="Genre" Width="120" DisplayMemberBinding="{Binding DisplayGenre}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- history -->
                <TabItem Header="History">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Clear history" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding HistoryRetentionDays, StringFormat=Entries older than {0} days are removed automatically.}"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{Binding History}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSessionStart}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="When" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StartedUtc, Converter={StaticResource DateToLocal}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Title" Width="330" DisplayMemberBinding="{Binding DisplayTitle}"/>
                                    <GridViewColumn Header="Artist" Width="180" DisplayMemberBinding="{Binding DisplayArtist}"/>
                                    <GridViewColumn Header="Genre" Width="120" DisplayMemberBinding="{Binding DisplayGenre}"/>
                                    <GridViewColumn Header="Played (s)" Width="80" DisplayMemberBinding="{Binding DisplayPlayed}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- artists -->
                <TabItem Header="Artists">
                    <Grid Margin="0,8,0,0">
                        <ListView x:Name="ArtistList" ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}"
                                  MouseDoubleClick="ArtistList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Artist" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Main genre" Width="160" DisplayMemberBinding="{Binding Genre}"/>
                                    <GridViewColumn Header="Tracks" Width="80" DisplayMemberBinding="{Binding TrackCount}"/>
                                    <GridViewColumn Header="Plays" Width="80" DisplayMemberBinding="{Binding PlayCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- settings -->
                <TabItem Header="Settings">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Music folder" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseLibraryRoot_Click"/>
                                <Button Grid.Column="2" Content="Rescan" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding RescanCommand}"/>
                            </Grid>

                            <TextBlock Text="Classification" FontWeight="SemiBold" Margin="0,18,0,4"/>
                            <CheckBox Content="Search online (Deezer / MusicBrainz) for track and artist genres"
                                      IsChecked="{Binding OnlineClassification}" Foreground="{StaticResource Text}" Margin="0,4"/>
                            <CheckBox Content="Fall back to the local acoustic model when nothing is found online"
                                      IsChecked="{Binding LocalModelFallback}" Foreground="{StaticResource Text}" Margin="0,4"/>
                            <Button Content="Re-check model guesses online" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Command="{Binding ImproveGenresCommand}"
                                    ToolTip="Looks up the tracks that were only guessed locally once more on the internet"/>

                            <TextBlock Text="Behaviour" FontWeight="SemiBold" Margin="0,18,0,4"/>
                            <CheckBox Content="Minimise to the tray instead of the taskbar (keeps playing)"
                                      IsChecked="{Binding MinimizeToTray}" Foreground="{StaticResource Text}" Margin="0,4"/>
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Closing the window (X) exits the player. Use minimise or the tray menu to keep it running."/>

                            <TextBlock Text="History retention (days)" FontWeight="SemiBold" Margin="0,18,0,4"/>
                            <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="0,20,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="The library database (universal_player.db) and settings live next to the executable, in the music folder."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- queue -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearQueueCommand}" Padding="8,3"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                            <Run Text="Up next ("/><Run Text="{Binding Queue.Count, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </DockPanel>
                    <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueTrack}"
                              MouseDoubleClick="QueueList_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play" Command="{Binding PlayQueueItemCommand}" CommandParameter="{Binding SelectedQueueTrack}"/>
                                <MenuItem Header="Remove from queue" Command="{Binding RemoveFromQueueCommand}" CommandParameter="{Binding SelectedQueueTrack}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding DisplayTitle}"/>
                                <GridViewColumn Header="Genre" Width="100" DisplayMemberBinding="{Binding DisplayGenre}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= player bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding CurrentTrack.DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding CurrentTrack.DisplayArtist, Mode=OneWay}"/>
                        <Run Text="  &#x2022;  "/>
                        <Run Text="{Binding CurrentTrack.DisplayGenre, Mode=OneWay}"/>
                        <Run Text="  &#x2022;  "/>
                        <Run Text="{Binding CurrentTrack.GenreSource, Converter={StaticResource GenreSource}, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Content="&#x25C0;&#x25C0;" Command="{Binding PreviousCommand}" ToolTip="Previous"/>
                        <Button Style="{StaticResource TransportButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Width="52" Height="52" FontSize="22" Background="{StaticResource AccentGradient}" BorderBrush="Transparent" ToolTip="Play / Pause"/>
                        <Button Style="{StaticResource TransportButton}" Content="&#x25B6;&#x25B6;" Command="{Binding NextCommand}" ToolTip="Next"/>
                        <Button Style="{StaticResource TransportButton}" Content="&#x25A0;" Command="{Binding StopCommand}" ToolTip="Stop"/>
                    </StackPanel>

                    <Grid Margin="0,8,0,0" Width="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Width="46" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="{Binding PositionSeconds, Converter={StaticResource SecToTime}}"/>
                        <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0"
                                Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"/>
                        <TextBlock Grid.Column="2" Width="46" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="{Binding DurationSeconds, Converter={StaticResource SecToTime}}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Shuffle" IsChecked="{Binding Shuffle}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{Binding RepeatLabel}" Command="{Binding CycleRepeatCommand}" Margin="0,0,12,0" Width="110"/>
                    <CheckBox Content="Next song: similar" ToolTip="Auto-play the most similar remaining track when the queue ends (no repeats in a session)"
                              IsChecked="{Binding AutoRecommend}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="&#x1F50A;" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <Slider Width="110" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= status ================= -->
        <Border Grid.Row="3" Background="{StaticResource Bg}" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding PendingClassifyText}" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding AnalysisStatusText}" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="3" Width="220" Height="8" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
